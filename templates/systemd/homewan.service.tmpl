[Unit]
Description=homewan containers
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor={{DATA_DIR}}
#%if FEAT_CAPTURE
After=homewan-capture.service
Wants=homewan-capture.service
#%endif

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/homewan up
ExecStop=/usr/local/bin/homewan down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
