# homewan containers. Rendered by the installer from templates/compose.yml.tmpl;
# edit site.conf and run "sudo homewan apply" instead of editing this file.
# ${NAME} values are secrets, read from secrets.env when the stack starts.
name: homewan

services:
  influxdb:
    image: influxdb:2.7.12
    restart: "{{RESTART}}"
    ports:
      - "{{INFLUX_BIND}}:{{INFLUX_PORT}}:8086"
    volumes:
      - {{DATA_DIR}}/influxdb/data:/var/lib/influxdb2
      - {{DATA_DIR}}/influxdb/config:/etc/influxdb2
    environment:
      DOCKER_INFLUXDB_INIT_MODE: setup
      DOCKER_INFLUXDB_INIT_USERNAME: admin
      DOCKER_INFLUXDB_INIT_PASSWORD: ${INFLUX_ADMIN_PASSWORD:?}
      DOCKER_INFLUXDB_INIT_ORG: {{INFLUX_ORG}}
      DOCKER_INFLUXDB_INIT_BUCKET: network
      DOCKER_INFLUXDB_INIT_ADMIN_TOKEN: ${INFLUX_OPERATOR_TOKEN:?}
#%if RETENTION_DURATION
      DOCKER_INFLUXDB_INIT_RETENTION: {{RETENTION_DURATION}}
#%endif
    healthcheck:
      test: ["CMD", "influx", "ping"]
      interval: 10s
      timeout: 5s
      retries: 30

  telegraf:
    image: telegraf:1.40.1
    restart: "{{RESTART}}"
    hostname: homewan
    user: root
    entrypoint: ["telegraf", "--config", "/etc/telegraf/telegraf.conf"]
    volumes:
      - {{RENDERED}}/telegraf.conf:/etc/telegraf/telegraf.conf:ro
      - /:/hostfs:ro,rslave
    environment:
      HOST_PROC: /hostfs/proc
      HOST_SYS: /hostfs/sys
      HOST_ETC: /hostfs/etc
      HOST_MOUNT_PREFIX: /hostfs
      INFLUX_TOKEN: ${INFLUX_TOKEN_TELEGRAF:-}
    depends_on:
      influxdb:
        condition: service_healthy

#%if FEAT_CAPTURE
  redis:
    image: redis:8.6.7-alpine
    restart: "{{RESTART}}"
    network_mode: host
    command: ["redis-server", "--bind", "127.0.0.1", "--port", "{{REDIS_PORT}}", "--save", "300 1", "--dir", "/data"]
    volumes:
      - {{DATA_DIR}}/redis:/data

  ntopng:
    build: {{HOMEWAN_ROOT}}/images/ntopng
    image: homewan/ntopng:local
    restart: "{{RESTART}}"
    network_mode: host
    cap_add: [NET_ADMIN, NET_RAW]
    volumes:
      - {{DATA_DIR}}/ntopng:/var/lib/ntopng
    command:
      - --interface={{CAPTURE_IFACE}}
      - --http-port={{NTOPNG_PORT}}
      - --local-networks={{LAN_SUBNET}}
      - --redis=127.0.0.1:{{REDIS_PORT}}
      - --data-dir=/var/lib/ntopng
      - --dont-change-user
    depends_on:
      - redis
      - influxdb

#%endif
#%if FEAT_GRAFANA
  grafana:
    image: grafana/grafana:12.4.12
    restart: "{{RESTART}}"
    ports:
      - "{{GRAFANA_PORT}}:3000"
    volumes:
      - {{DATA_DIR}}/grafana:/var/lib/grafana
      - {{RENDERED}}/grafana:/etc/grafana/provisioning:ro
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GRAFANA_ADMIN_PASSWORD:?}
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      HOMEWAN_INFLUX_TOKEN: ${INFLUX_TOKEN_GRAFANA:-}
    depends_on:
      influxdb:
        condition: service_healthy

#%endif
  # Built here; the homewan command runs it on demand (homewan run JOB),
  # passing the settings and tokens each job needs.
  tools:
    build: {{HOMEWAN_ROOT}}/images/tools
    image: homewan/tools:local
    profiles: [tools]
