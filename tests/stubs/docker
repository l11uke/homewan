#!/usr/bin/env python3
"""Test stand-in for docker: records every call, and imitates the parts of
docker compose, the influx CLI and redis-cli that deploy.sh uses."""
import json, os, sys

state_path = os.environ["STUB_STATE"]
log = os.environ["STUB_LOG"]
st = json.load(open(state_path)) if os.path.exists(state_path) else {"buckets": {}, "auths": [], "v1": [], "redis": {}, "n": 0}
args = sys.argv[1:]
with open(log, "a") as f:
    f.write(" ".join(args) + "\n")

def save():
    json.dump(st, open(state_path, "w"))

def flag(name):
    return args[args.index(name) + 1] if name in args else None

out = ""
if args[:1] == ["compose"]:
    if "exec" in args:
        i = args.index("exec")
        svc, cmd = args[i + 2], args[i + 3:]
        if cmd[:1] == ["influx"]:
            sub = cmd[1:3]
            if sub[0] == "ping":
                out = "OK"
            elif sub == ["bucket", "list"]:
                name = flag("--name")
                out = json.dumps([{"id": st["buckets"][name], "name": name}] if name in st["buckets"] else [])
            elif sub == ["bucket", "create"]:
                st["n"] += 1; st["buckets"][flag("--name")] = f"b{st['n']}"
            elif sub == ["bucket", "update"]:
                pass
            elif sub == ["auth", "list"]:
                out = json.dumps(st["auths"])
            elif sub == ["auth", "create"]:
                st["n"] += 1
                a = {"id": f"a{st['n']}", "token": f"tok{st['n']}", "status": "active", "description": flag("--description")}
                st["auths"].append(a); out = json.dumps(a)
            elif sub == ["auth", "delete"]:
                st["auths"] = [a for a in st["auths"] if a["id"] != flag("--id")]
            elif sub == ["v1", "auth"]:
                op = cmd[3]
                if op == "list":
                    out = json.dumps(st["v1"])
                elif op == "create":
                    st["v1"].append({"userName": flag("--username")})
            elif sub[0] == "query":
                out = "#datatype,string\n,result,table,_value\n,_result,0,5\n"
        elif cmd[:1] == ["redis-cli"]:
            if "ping" in cmd:
                out = "PONG"
            elif "SET" in cmd:
                j = cmd.index("SET"); st["redis"][cmd[j + 1]] = cmd[j + 2]; out = "OK"
    elif "ps" in args:
        out = "running" if "--format" in args else "cid123"
elif args[:2] == ["image", "inspect"]:
    sys.exit(0)
save()
if out:
    print(out)
